# Public keys are safe in the browser. Service, payment, and email keys stay on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# This address becomes the admin after they create an account.
ADMIN_EMAIL=

# Moolre sandbox first. Live host is https://api.moolre.com
MOOLRE_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
MOOLRE_WEBHOOK_SECRET=

# Resend and Taysend run only after a payment is confirmed.
RESEND_API_KEY=
RESEND_FROM=
TAYSEND_API_KEY=
TAYSEND_SENDER_ID=
